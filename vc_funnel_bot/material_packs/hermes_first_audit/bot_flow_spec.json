      {
        "callback": "hb:stage:find",
        "label": "🧭 Нет клиентов",
        "pain": "find_business"
      },
      {
        "callback": "hb:stage:offer",
        "label": "💬 Есть клиенты, не знаю что предложить",
        "pain": "offer"
      },
      {
        "callback": "hb:stage:build",
        "label": "🛠 Есть предложение, нет решения",
        "pain": "build"
      },
      {
        "callback": "hb:stage:deal",
        "label": "💰 Есть решение, нет сделки",
        "pain": "deal"
      },
      {
        "callback": "hb:stage:setup",
        "label": "⚙️ Не получается запустить Hermes",
        "pain": "setup"
      }
    ]
  },
  "question_2_general": {
    "text": "Что у вас уже есть?",
    "options": [
      {
        "callback": "hb:asset:warm",
        "label": "Есть знакомые предприниматели",
        "segment": "warm_business_contacts"
      },
      {
        "callback": "hb:asset:rko",
        "label": "Есть РКО-клиенты или база",
        "segment": "rko_base"
      },
      {
        "callback": "hb:asset:channel",
        "label": "Есть канал или аудитория",
        "segment": "channel_audience"
      },
      {
        "callback": "hb:asset:none",
        "label": "Пока ничего — нужен маршрут",
        "segment": "no_asset"
      }
    ]
  },
  "question_2_setup": {
    "text": "На каком этапе возникла проблема?",
