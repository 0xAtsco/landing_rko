      },
      {
        "callback": "hb:stage:offer",
        "label": "💬 Есть бизнес, не знаю, что предложить",
        "pain": "offer"
      },
      {
        "callback": "hb:stage:build",
        "label": "🛠 Есть задача, не могу собрать решение",
        "pain": "build"
      },
      {
        "callback": "hb:stage:deal",
        "label": "💰 Решение есть, не понимаю, как продать",
        "pain": "deal"
      },
      {
        "callback": "hb:stage:setup",
        "label": "⚙️ Hermes не запустился",
        "pain": "setup"
      }
    ]
