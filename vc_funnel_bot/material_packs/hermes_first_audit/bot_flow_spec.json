      {
        "callback": "hb:setup:windows",
        "label": "Windows: установка или запуск",
        "segment": "windows"
      },
      {
        "callback": "hb:setup:mac",
        "label": "macOS: установка или запуск",
        "segment": "macos"
      },
      {
        "callback": "hb:setup:model",
